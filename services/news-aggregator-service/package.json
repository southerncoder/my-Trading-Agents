{
  "name": "news-aggregator-service",
  "version": "1.0.0",
  "description": "Unified news aggregation service combining multiple news providers with intelligent fallback",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/integration",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:manual:bing": "node tests/manual/bing-news.manual.test.js",
    "test:manual:brave-config": "node tests/manual/brave-config.manual.test.js",
    "test:manual:providers": "node tests/manual/all-providers.manual.test.js",
    "test:manual:all": "npm run test:manual:bing && npm run test:manual:brave-config && npm run test:manual:providers"
  },
  "keywords": [
    "news",
    "aggregation",
    "api",
    "finance",
    "trading",
    "google-news",
    "yahoo-finance",
    "bing-news",
    "newsapi"
  ],
  "author": "TradingAgents",
  "license": "MIT",
  "dependencies": {
    "@tavily/core": "^1.1.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "newsapi": "^2.4.1",
    "node-cache": "^5.1.2",
    "winston": "^3.18.3",
    "yahoo-finance2": "^4.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
