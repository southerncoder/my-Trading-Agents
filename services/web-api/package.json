{
  "name": "trading-agents-web-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Web API server for TradingAgents frontend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec \"node --loader ts-node/esm src/server.ts\"",
    "dev:https": "cross-env HTTPS_ENABLED=true nodemon --exec \"node --loader ts-node/esm src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:https": "cross-env HTTPS_ENABLED=true node dist/server.js",
    "generate-certs": "bash scripts/generate-local-certs.sh",
    "generate-certs:windows": "powershell -ExecutionPolicy Bypass -File scripts/generate-local-certs.ps1",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "docker:build": "docker build -t trading-agents-web-api .",
    "docker:run": "docker run -p 3001:3001 trading-agents-web-api",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.0.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.5.12",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.8"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "nodemon": {
      "minimatch": "^11.0.8"
    }
  }
}
