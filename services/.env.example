# TradingAgents Web Services Environment Configuration

# HTTPS Configuration
HTTPS_ENABLED=false

# Frontend Configuration
FRONTEND_URL=http://localhost:38400
VITE_API_URL=http://localhost:38401/api
VITE_WS_URL=ws://localhost:38401

# API Configuration
CORS_ORIGIN=http://localhost:38400
ALLOWED_ORIGINS=http://localhost:38400

# Development vs Production
NODE_ENV=development

# For HTTPS setup, use:
# HTTPS_ENABLED=true
# FRONTEND_URL=https://localhost:38400
# VITE_API_URL=https://localhost:38401/api
# VITE_WS_URL=wss://localhost:38401
# CORS_ORIGIN=https://localhost:38400
# ALLOWED_ORIGINS=https://localhost:38400